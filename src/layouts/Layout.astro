---
import '../styles/global.css';
import { getTranslations } from '../utils/i18n';
import ProjectModal from '../components/ProjectModal.astro';

interface Props {
  title: string;
  description?: string;
}

const locale = Astro.cookies.get('locale')?.value === 'en' ? 'en' : 'es';
const t = getTranslations(locale);

const { title, description = t.footer.brand.tagline } = Astro.props;
---

<!DOCTYPE html>
<html lang={locale} class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&family=Work+Sans:ital,wght@0,300;0,400;0,500;0,600;1,400&display=swap" rel="stylesheet" />

    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />

    <title>{title}</title>
  </head>
  <body class="h-full">
    <slot />
    <ProjectModal />
  </body>
</html>
