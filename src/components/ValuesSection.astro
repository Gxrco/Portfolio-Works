---
import { getTranslations } from '../utils/i18n';

const locale = Astro.cookies.get('locale')?.value === 'en' ? 'en' : 'es';
const t = getTranslations(locale);
---

<section class="w-full flex flex-col gap-6 md:gap-8 py-0 px-4 md:px-8 lg:px-[150px]">
  <div class="w-full max-w-[1200px] mx-auto">
    <div class="flex flex-col md:flex-row md:items-center gap-4 md:gap-[60px] w-full mb-4 md:mb-0">
      <h2 class="font-primary text-2xl md:text-[32px] font-semibold text-[var(--color-text-primary)] tracking-[-0.6px]">
        {t.values.title}
      </h2>
      <p class="font-secondary text-sm md:text-[17px] font-normal text-[var(--color-text-muted)]">
        {t.values.tagline}
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 md:gap-6 w-full">
      {t.values.items.map((value) => (
        <div class="flex flex-col gap-2 p-4 border border-[var(--color-border-weak)] rounded-2xl w-full">
          <span class="text-[var(--color-accent)] material-symbols-outlined" style="font-weight: 100; font-size: 50px;">
            {value.icon}
          </span>
          <h3 class="font-primary text-base font-semibold text-[var(--color-text-primary)]">
            {value.title}
          </h3>
          <p class="font-secondary text-[13px] font-normal text-[var(--color-text-muted)] w-full">
            {value.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
