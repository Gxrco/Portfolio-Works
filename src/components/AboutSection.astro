---
import { getTranslations } from '../utils/i18n';

const locale = Astro.cookies.get('locale')?.value === 'en' ? 'en' : 'es';
const t = getTranslations(locale);
---

<section id="sobre-mi" class="w-full bg-[var(--color-bg-primary)] flex justify-center items-center py-12 md:py-16 lg:py-24 px-4 md:px-8 lg:px-[150px]">
  <div class="flex flex-col lg:flex-row gap-8 md:gap-12 lg:gap-20 w-full max-w-[1200px] mx-auto">
    <div class="flex flex-col gap-4 md:gap-6 w-full lg:flex-1">
      <h2 class="font-primary text-3xl md:text-4xl lg:text-[42px] font-bold text-[var(--color-text-primary)] tracking-[-0.8px]">
        {t.about.title}
      </h2>

      <p class="font-secondary text-base md:text-lg lg:text-xl font-normal text-[var(--color-text-secondary)] leading-[1.7] w-full">
        {t.about.paragraph1}
      </p>

      <p class="font-secondary text-base md:text-lg lg:text-xl font-normal text-[var(--color-text-secondary)] leading-[1.7] w-full">
        {t.about.paragraph2}
      </p>

      <p class="font-primary text-lg md:text-xl lg:text-[22px] font-semibold text-[var(--color-text-primary)] tracking-[-0.3px]">
        {t.about.statement}
      </p>
    </div>

    <div class="flex flex-col gap-8 md:gap-10 lg:gap-12 w-full lg:flex-1">
      <div class="flex gap-3 md:gap-4 w-full">
        <div class="w-[3px] h-full bg-[var(--color-accent-secondary)] rounded-sm flex-shrink-0"></div>
        <div class="flex flex-col gap-2 md:gap-3 w-full">
          <h3 class="font-primary text-base md:text-lg font-semibold text-[var(--color-text-primary)]">
            {t.about.mission.title}
          </h3>
          <p class="font-secondary text-sm md:text-base text-[var(--color-text-secondary)] leading-[1.6]">
            {t.about.mission.description}
          </p>
        </div>
      </div>

      <div class="flex gap-3 md:gap-4 w-full">
        <div class="w-[3px] h-full bg-[var(--color-accent-secondary)] rounded-sm flex-shrink-0"></div>
        <div class="flex flex-col gap-2 md:gap-3 w-full">
          <h3 class="font-primary text-base md:text-lg font-semibold text-[var(--color-text-primary)]">
            {t.about.vision.title}
          </h3>
          <p class="font-secondary text-sm md:text-base text-[var(--color-text-secondary)] leading-[1.6]">
            {t.about.vision.description}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
