---
import { getTranslations } from '../utils/i18n';

const locale = Astro.cookies.get('locale')?.value === 'en' ? 'en' : 'es';
const t = getTranslations(locale);

const filterKeys = ['all', 'web', 'ui', 'backend'] as const;
type FilterKey = (typeof filterKeys)[number];

const normalize = (value: string) =>
  value
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '');

const resolveProjectFilter = (category: string): Exclude<FilterKey, 'all'> => {
  const normalizedCategory = normalize(category);

  if (
    normalizedCategory.includes('backend') ||
    normalizedCategory.includes('api') ||
    normalizedCategory.includes('microservice') ||
    normalizedCategory.includes('rest')
  ) {
    return 'backend';
  }

  if (normalizedCategory.includes('ui')) {
    return 'ui';
  }

  return 'web';
};

const filters = filterKeys.map((key) => ({ key, label: t.projects.filters[key] }));
const projects = t.projects.items.map((project) => ({
  ...project,
  filter: resolveProjectFilter(project.category),
}));

const [featured, secondary, ...smallProjects] = projects;
---

<section id="proyectos" data-projects-root class="w-full bg-[var(--color-bg-secondary)] flex justify-center py-12 md:py-16 lg:py-24 px-4 md:px-8 lg:px-[150px]">
  <div class="flex flex-col gap-8 md:gap-10 lg:gap-12 w-full max-w-[1200px] mx-auto">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 w-full">
      <h2 class="font-primary text-2xl md:text-[32px] font-semibold text-[var(--color-text-primary)] tracking-[-0.6px]">
        {t.projects.title}
      </h2>

      <div class="flex gap-2 overflow-x-auto pb-2 md:pb-0">
        {filters.map(({ key, label }) => (
          <button
            type="button"
            data-filter={key}
            data-active={key === 'all' ? 'true' : 'false'}
            aria-pressed={key === 'all' ? 'true' : 'false'}
            class="project-filter-btn px-4 md:px-5 py-2 md:py-[10px] border rounded-[20px] font-secondary text-xs md:text-[13px] font-medium transition-all whitespace-nowrap border-[var(--color-border-strong)] hover:border-[var(--color-accent)] hover:text-[var(--color-text-primary)] data-[active=true]:bg-[var(--color-accent)] data-[active=true]:border-[var(--color-accent)] data-[active=true]:text-black data-[active=true]:font-semibold data-[active=false]:bg-transparent data-[active=false]:text-[var(--color-text-muted)]"
          >
            {label}
          </button>
        ))}
      </div>
    </div>

    <div class="flex flex-col gap-4 md:gap-6 w-full">
      <div class="project-row flex flex-col lg:flex-row gap-4 md:gap-6 w-full">
        <div data-filter={featured.filter} class="project-card w-full lg:w-[776px] min-h-[380px] md:min-h-[420px] bg-[var(--color-bg-primary)] border border-[var(--color-border-strong)] rounded-[20px] p-6 md:p-8 flex flex-col justify-between gap-4 md:gap-5">
          <div class="flex flex-col gap-3 md:gap-4">
            <span class="font-secondary text-xs font-medium text-[var(--color-accent)] tracking-[1px]">
              {featured.category}
            </span>

            <h3 class="font-primary text-2xl md:text-[30px] font-bold text-[var(--color-text-primary)] tracking-[-0.6px]">
              {featured.title}
            </h3>

            <p class="font-secondary text-sm md:text-base font-normal text-[var(--color-text-secondary)] leading-[1.5] w-full">
              {featured.description}
            </p>

            {featured.tech && featured.tech.length > 0 && (
              <div class="flex flex-wrap gap-2">
                {featured.tech.map((tech) => (
                  <span class="px-3 py-[5px] bg-[var(--color-border)] rounded-[10px] font-secondary text-[11px] font-medium text-[var(--color-text-primary)]">
                    {tech}
                  </span>
                ))}
              </div>
            )}
          </div>

          <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 sm:gap-0 w-full">
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-[var(--color-accent)] text-base" style="font-weight: 100;">trending_up</span>
              <span class="font-secondary text-xs md:text-sm font-medium text-[var(--color-accent)]">
                {featured.metric}
              </span>
            </div>
            <a href="#" class="font-secondary text-xs md:text-sm font-semibold text-[var(--color-accent)] hover:underline">
              {t.projects.cta}
            </a>
          </div>
        </div>

        <div data-filter={secondary.filter} class="project-card flex-1 min-h-[380px] md:min-h-[420px] bg-[var(--color-bg-primary)] border border-[var(--color-border-strong)] rounded-[20px] p-6 md:p-7 flex flex-col justify-between gap-4 md:gap-5">
          <div class="flex flex-col gap-3 md:gap-4">
            <span class="font-secondary text-xs font-semibold text-[var(--color-accent-secondary)] tracking-[1px]">
              {secondary.category}
            </span>

            <h3 class="font-primary text-xl md:text-2xl font-bold text-[var(--color-text-primary)] tracking-[-0.4px]">
              {secondary.title}
            </h3>

            <p class="font-secondary text-sm md:text-[15px] font-normal text-[var(--color-text-secondary)] leading-[1.5] w-full">
              {secondary.description}
            </p>

            {secondary.tech && secondary.tech.length > 0 && (
              <div class="flex flex-wrap gap-2">
                {secondary.tech.map((tech) => (
                  <span class="px-3 py-[5px] bg-[var(--color-border)] rounded-[10px] font-secondary text-[11px] font-medium text-[var(--color-text-primary)]">
                    {tech}
                  </span>
                ))}
              </div>
            )}
          </div>

          <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 sm:gap-0 w-full">
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-[var(--color-accent)] text-base" style="font-weight: 100;">trending_up</span>
              <span class="font-secondary text-xs md:text-sm font-medium text-[var(--color-accent)]">
                {secondary.metric}
              </span>
            </div>
            <a href="#" class="font-secondary text-xs md:text-sm font-semibold text-[var(--color-accent)] hover:underline">
              {t.projects.cta}
            </a>
          </div>
        </div>
      </div>

      <div class="project-row grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6 w-full">
        {smallProjects.map((project) => (
          <div data-filter={project.filter} class="project-card min-h-[320px] md:min-h-[340px] bg-[var(--color-bg-primary)] border border-[var(--color-border-strong)] rounded-[20px] p-5 md:p-6 flex flex-col justify-between gap-3 md:gap-4">
            <div class="flex flex-col gap-2 md:gap-3">
              <span class="font-secondary text-xs font-semibold text-[var(--color-accent)] tracking-[1px]">
                {project.category}
              </span>

              <h3 class="font-primary text-lg md:text-xl font-bold text-[var(--color-text-primary)] tracking-[-0.4px]">
                {project.title}
              </h3>

              <p class="font-secondary text-sm font-normal text-[var(--color-text-secondary)] leading-[1.4] w-full">
                {project.description}
              </p>

              {project.tech && project.tech.length > 0 && (
                <div class="flex flex-wrap gap-[6px]">
                  {project.tech.map((tech) => (
                    <span class="px-[10px] py-1 bg-[var(--color-border-weak)] rounded-[10px] font-secondary text-[11px] font-medium text-[var(--color-text-primary)]">
                      {tech}
                    </span>
                  ))}
                </div>
              )}
            </div>

            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2 w-full">
              <span class="font-secondary text-xs md:text-[13px] font-medium text-[var(--color-accent)]">
                {project.metric}
              </span>
              <a href="#" class="font-secondary text-xs md:text-[13px] font-semibold text-[var(--color-accent)] hover:underline">
                {t.projects.cta}
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const initProjectFilters = () => {
    const section = document.querySelector('[data-projects-root]');
    if (!section) return;
    if (section.dataset.filtersReady === 'true') return;
    section.dataset.filtersReady = 'true';

    const buttons = Array.from(section.querySelectorAll('.project-filter-btn'));
    const cards = Array.from(section.querySelectorAll('.project-card'));
    const rows = Array.from(section.querySelectorAll('.project-row'));

    const applyFilter = (filter) => {
      cards.forEach((card) => {
        const matches = filter === 'all' || card.dataset.filter === filter;
        card.classList.toggle('hidden', !matches);
      });

      rows.forEach((row) => {
        const hasVisibleCards = row.querySelector('.project-card:not(.hidden)');
        row.classList.toggle('hidden', !hasVisibleCards);
      });

      buttons.forEach((button) => {
        const isActive = button.dataset.filter === filter;
        button.dataset.active = String(isActive);
        button.setAttribute('aria-pressed', String(isActive));
      });
    };

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        applyFilter(button.dataset.filter || 'all');
      });
    });

    applyFilter('all');
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProjectFilters, { once: true });
  } else {
    initProjectFilters();
  }

  document.addEventListener('astro:page-load', initProjectFilters);
</script>
