---
import { getTranslations } from '../utils/i18n';
import ProjectCard from './ProjectCard.astro';

const locale = Astro.cookies.get('locale')?.value === 'en' ? 'en' : 'es';
const t = getTranslations(locale);

const filterKeys = ['all', 'web', 'ui', 'backend'] as const;
type FilterKey = (typeof filterKeys)[number];

const normalize = (value: string) =>
  value
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '');

const resolveProjectFilter = (category: string): Exclude<FilterKey, 'all'> => {
  const normalizedCategory = normalize(category);

  if (
    normalizedCategory.includes('backend') ||
    normalizedCategory.includes('api') ||
    normalizedCategory.includes('microservice') ||
    normalizedCategory.includes('rest')
  ) {
    return 'backend';
  }

  if (normalizedCategory.includes('ui')) {
    return 'ui';
  }

  return 'web';
};

const filters = filterKeys.map((key) => ({ key, label: t.projects.filters[key] }));
const projects = t.projects.items.map((project) => ({
  ...project,
  filter: resolveProjectFilter(project.category),
}));
---

<section id="proyectos" data-projects-root class="w-full bg-[var(--color-bg-secondary)] flex justify-center py-12 md:py-16 lg:py-24 px-4 md:px-8 lg:px-[150px]">
  <div class="flex flex-col gap-8 md:gap-10 lg:gap-12 w-full max-w-[1200px] mx-auto">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 w-full">
      <h2 class="font-primary text-2xl md:text-[32px] font-semibold text-[var(--color-text-primary)] tracking-[-0.6px]">
        {t.projects.title}
      </h2>

      <div class="flex gap-2 overflow-x-auto pb-2 md:pb-0">
        {filters.map(({ key, label }) => (
          <button
            type="button"
            data-filter={key}
            data-active={key === 'all' ? 'true' : 'false'}
            aria-pressed={key === 'all' ? 'true' : 'false'}
            class="project-filter-btn px-4 md:px-5 py-2 md:py-[10px] border rounded-[20px] font-secondary text-xs md:text-[13px] font-medium transition-all whitespace-nowrap border-[var(--color-border-strong)] hover:border-[var(--color-accent)] hover:text-[var(--color-text-primary)] data-[active=true]:bg-[var(--color-accent)] data-[active=true]:border-[var(--color-accent)] data-[active=true]:text-black data-[active=true]:font-semibold data-[active=false]:bg-transparent data-[active=false]:text-[var(--color-text-muted)]"
          >
            {label}
          </button>
        ))}
      </div>
    </div>

    <div class="flex flex-col gap-4 md:gap-6 w-full" data-cards-container>
      <div class="project-row-primary flex flex-col lg:flex-row gap-4 md:gap-6 w-full"></div>
      <div class="project-row-secondary grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6 w-full"></div>

      <!-- Template inicial - se moverá dinámicamente -->
      <template data-cards-template>
        {projects.map((project, index) => (
          <ProjectCard project={project} index={index} ctaText={t.projects.cta} />
        ))}
      </template>
    </div>
  </div>
</section>

<script>
  import { createCardLayoutManager } from '../utils/cardLayoutManager';

  const initProjectFilters = () => {
    const section = document.querySelector('[data-projects-root]');
    if (!section) return;
    if (section.dataset.filtersReady === 'true') return;
    section.dataset.filtersReady = 'true';

    const buttons = Array.from(section.querySelectorAll('.project-filter-btn'));
    const container = section.querySelector('[data-cards-container]') as HTMLElement;
    const template = section.querySelector('[data-cards-template]') as HTMLTemplateElement;

    if (!container || !template) return;

    // Initialize layout manager
    const layoutManager = createCardLayoutManager();

    // Move cards from template to container initially
    const templateContent = template.content;
    const cards = Array.from(templateContent.querySelectorAll('.project-card'));
    const firstRow = container.querySelector('.project-row-primary') as HTMLElement;

    if (firstRow) {
      cards.forEach(card => {
        firstRow.appendChild(card.cloneNode(true));
      });
    }

    // Get projects data for modal
    const projectsData = Array.from(section.querySelectorAll('.project-card')).map((card) => {
      const projectId = card.getAttribute('data-project-id');
      return (window as any).__PROJECTS_DATA__?.find((p: any) => p.id === projectId);
    }).filter(Boolean);

    const applyFilter = async (filter: string) => {
      const allCards = Array.from(container.querySelectorAll('.project-card'));

      allCards.forEach((card) => {
        const matches = filter === 'all' || card.getAttribute('data-filter') === filter;
        card.classList.toggle('hidden', !matches);
      });

      await layoutManager.applyDynamicSizing(container);

      buttons.forEach((button) => {
        const isActive = button.getAttribute('data-filter') === filter;
        button.setAttribute('data-active', String(isActive));
        button.setAttribute('aria-pressed', String(isActive));
      });

      // Re-setup modal triggers after layout change
      setupModalTriggers();
    };

    const setupModalTriggers = () => {
      const triggers = section.querySelectorAll('[data-project-trigger]');
      triggers.forEach(trigger => {
        const newTrigger = trigger.cloneNode(true) as HTMLElement;
        trigger.replaceWith(newTrigger);

        newTrigger.addEventListener('click', (e) => {
          e.preventDefault();
          const index = parseInt(newTrigger.getAttribute('data-project-index') || '0');
          const project = projectsData[index];

          if (typeof (window as any).openProjectModal === 'function' && project) {
            (window as any).openProjectModal(project);
          }
        });
      });
    };

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        applyFilter(button.getAttribute('data-filter') || 'all');
      });
    });

    // Initialize layout
    layoutManager.applyDynamicSizing(container).then(() => {
      setupModalTriggers();
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProjectFilters, { once: true });
  } else {
    initProjectFilters();
  }

  document.addEventListener('astro:page-load', initProjectFilters);
</script>

<script define:vars={{ projects }}>
  // Pass projects data to global scope for modal
  window.__PROJECTS_DATA__ = projects;
</script>
